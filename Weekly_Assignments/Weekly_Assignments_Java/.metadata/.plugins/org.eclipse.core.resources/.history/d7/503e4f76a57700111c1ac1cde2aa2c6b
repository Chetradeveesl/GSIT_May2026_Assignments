package Week2_04_07_2026;

public class Program3_FrequencyofEachElementInArray {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int arr[] = {4, 2, 4, 6, 2, 2, 7};
		int count=0;
		for(int i=0;i<=arr.length;i++)
		{
			for(int j=0;j<i;j++)
			{
				if(arr[i]==arr[j])
					count++;
			}
		}
	}

}
