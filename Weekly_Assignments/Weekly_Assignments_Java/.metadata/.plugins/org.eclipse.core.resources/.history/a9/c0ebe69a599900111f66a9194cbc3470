package Week6_07_08_2026;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.HashMap;
import java.util.Map;

public class Program4_WordFrequencyFileHandling {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		 String fileName = "input.txt";
	        Map<String, Integer> wordCount = new HashMap<>();

	        try (BufferedReader br = new BufferedReader(new FileReader("C:\\Users\\Chetradevee\\OneDrive\\Desktop\\Automation Testing\\Assignment\\Assignment_Answers\\Weekly_Assignments\\sampleData.txt"))) {

	            String line;

	            while ((line = br.readLine()) != null) {

	                // Convert to lowercase and remove punctuation
	                line = line.toLowerCase().replaceAll("[^a-zA-Z0-9 ]", "");

	                String[] words = line.split("\\s+");

	                for (String word : words) {
	                    if (!word.isEmpty()) {
	                        wordCount.put(word, wordCount.getOrDefault(word, 0) + 1);
	                    }
	                }
	            }

	            // Display word frequency
	            for (Map.Entry<String, Integer> entry : wordCount.entrySet()) {
	                System.out.println(entry.getKey() + " : " + entry.getValue());
	            }
	            
	        } catch (IOException e) {
	            System.out.println("Error reading the file: " + e.getMessage());
	        }
	}

}
